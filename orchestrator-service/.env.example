WEB_SOCKET_URL=
PROCESSING_ENGINE_URL=http://192.168.1.6:7001

# --- VAD endpointing / noise rejection (optional; defaults shown) ---
# WebRTC VAD aggressiveness: 0 (NORMAL) .. 3 (VERY_AGGRESSIVE). Higher = stricter.
VAD_MODE=3
# Min RMS energy (PCM16 scale 0..32767) for a frame to count as speech. Raise if
# background noise still triggers detection; lower if soft speech is missed.
RMS_SPEECH_THRESHOLD=600
# Consecutive voice frames (~100ms each) needed to start an utterance.
SPEECH_START_FRAMES=3
# Consecutive silence frames needed to end an utterance.
SPEECH_END_SILENCE_FRAMES=8
# Minimum voice frames an utterance must contain to be processed.
MIN_SPEECH_FRAMES=5
