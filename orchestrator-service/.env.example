# --- Remote GPU machine IP ---
# All service URLs (RabbitMQ, vLLM, processing engine) default to this IP.
# Override individual URLs below if services run on different machines.
REMOTE_IP=192.168.1.3

# --- HTTP / WebSocket server ---
PORT=3000

# --- Downstream processing engine (V1 monolithic path) ---
# Defaults to http://${REMOTE_IP}:7001 if not set.
# PROCESSING_ENGINE_URL=http://192.168.1.3:7001

# --- Energy gate (replaces VAD model) ---
# Min RMS energy (PCM16 scale 0..32767) for a frame to be forwarded to STT.
RMS_SPEECH_THRESHOLD=600

# --- STT streaming service ---
# Defaults to ws://${REMOTE_IP}:7003 if not set.
# STT_WS_URL=ws://192.168.1.3:7003

# --- RabbitMQ ---
# Defaults to amqp://voiceai:voiceai_password@${REMOTE_IP}:5672 if not set.
# RABBITMQ_URL=amqp://voiceai:voiceai_password@192.168.1.3:5672
# ORCHESTRATOR_INSTANCE_ID is auto-generated if not set.
STT_JOBS_QUEUE=stt.jobs
TTS_JOBS_QUEUE=tts.jobs

# --- Stage timeout ---
STAGE_TIMEOUT_MS=30000

# --- vLLM / LLM ---
# Defaults to http://${REMOTE_IP}:8000 if not set.
# VLLM_BASE_URL=http://192.168.1.3:8000
# TTS_STREAM_URL=http://192.168.1.3:7002
VLLM_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.6
LLM_SYSTEM_PROMPT=You are a helpful, conversational voice assistant. Keep answers brief, natural, and spoken-word friendly. Do not use markdown, emojis, or lists.
